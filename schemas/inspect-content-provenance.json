{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Neeeophytee/ai-watermarks-reality-check/schemas/inspect-content-provenance.json",
  "title": "inspect-content-provenance output",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "source",
    "kind",
    "manifest_presence",
    "integrity",
    "signer_trust",
    "c2pa_markers",
    "c2pa_mentions",
    "covert_channels",
    "text_watermark",
    "limitations",
    "recommended_next_step",
    "bytes",
    "sha256",
    "format",
    "scan_complete",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "tool": {
      "const": "inspect-content-provenance"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "file",
        "text"
      ]
    },
    "bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sha256": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "format": {
      "type": [
        "string",
        "null"
      ]
    },
    "scan_complete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "manifest_presence": {
      "$ref": "common.json#/$defs/manifest_presence"
    },
    "integrity": {
      "$ref": "common.json#/$defs/integrity"
    },
    "signer_trust": {
      "$ref": "common.json#/$defs/signer_trust"
    },
    "c2pa_markers": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/c2pa_marker"
      }
    },
    "c2pa_mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "covert_channels": {
      "$ref": "common.json#/$defs/covert_channels"
    },
    "text_watermark": {
      "type": "object",
      "required": [
        "provider",
        "status"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "status": {
          "$ref": "common.json#/$defs/text_watermark_status"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_step": {
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "$comment": "Byte-level inspection can never assert PRESENT; only a verifier can.",
      "not": {
        "properties": {
          "manifest_presence": {
            "const": "PRESENT"
          }
        },
        "required": [
          "manifest_presence"
        ]
      }
    },
    {
      "$comment": "Inspection never validates, so integrity is never VALID or INVALID.",
      "properties": {
        "integrity": {
          "enum": [
            "NOT_VERIFIED"
          ]
        }
      }
    },
    {
      "$comment": "POSSIBLE requires at least one located marker.",
      "if": {
        "properties": {
          "manifest_presence": {
            "const": "POSSIBLE"
          }
        },
        "required": [
          "manifest_presence"
        ]
      },
      "then": {
        "properties": {
          "c2pa_markers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "$comment": "A literal mention is not a marker and must not create POSSIBLE on its own.",
      "if": {
        "properties": {
          "c2pa_markers": {
            "maxItems": 0
          }
        },
        "required": [
          "c2pa_markers"
        ]
      },
      "then": {
        "properties": {
          "manifest_presence": {
            "enum": [
              "ABSENT",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          }
        }
      }
    },
    {
      "$comment": "An inconclusive presence must explain why absence could not be asserted.",
      "if": {
        "properties": {
          "manifest_presence": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "manifest_presence"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    }
  ]
}
