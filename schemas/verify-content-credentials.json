{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Neeeophytee/ai-watermarks-reality-check/schemas/verify-content-credentials.json",
  "title": "verify-content-credentials output",
  "type": "object",
  "required": [
    "schema_version", "tool", "mode", "asset", "asset_sha256", "verifier",
    "verifier_version", "verifier_supported", "network_allowed",
    "manifest_presence", "integrity", "signer_trust", "validation_state",
    "success_codes", "failure_codes", "schema_recognized", "manifest",
    "trust_anchors", "trust_exit_code", "trust_validation_state",
    "trust_success_codes", "trust_failure_codes", "tool_exit_code",
    "stderr_summary", "reason", "limitations"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "tool": { "const": "verify-content-credentials" },
    "mode": { "type": "string", "enum": ["live-verification", "captured-report"] },
    "asset": { "type": ["string", "null"] },
    "asset_sha256": { "oneOf": [{ "$ref": "common.json#/$defs/sha256" }, { "type": "null" }] },
    "verifier": { "type": ["string", "null"] },
    "verifier_version": { "type": ["string", "null"] },
    "verifier_supported": { "type": ["boolean", "null"] },
    "network_allowed": { "type": "boolean" },
    "manifest_presence": { "$ref": "common.json#/$defs/manifest_presence" },
    "integrity": { "$ref": "common.json#/$defs/integrity" },
    "signer_trust": { "$ref": "common.json#/$defs/signer_trust" },
    "validation_state": { "type": ["string", "null"], "enum": ["Valid", "Trusted", "Invalid", null] },
    "success_codes": { "type": "array", "items": { "type": "string" } },
    "failure_codes": { "type": "array", "items": { "type": "string" } },
    "schema_recognized": { "type": "boolean" },
    "manifest": { "$ref": "common.json#/$defs/manifest_summary" },
    "trust_anchors": { "type": ["string", "null"] },
    "trust_exit_code": { "type": ["integer", "null"] },
    "trust_validation_state": { "type": ["string", "null"] },
    "trust_success_codes": { "type": "array", "items": { "type": "string" } },
    "trust_failure_codes": { "type": "array", "items": { "type": "string" } },
    "tool_exit_code": { "type": ["integer", "null"] },
    "stderr_summary": { "type": "string" },
    "reason": { "type": ["string", "null"] },
    "reported_result": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "$comment": "VALID or INVALID integrity requires a present manifest.",
      "if": { "properties": { "integrity": { "enum": ["VALID", "INVALID"] } }, "required": ["integrity"] },
      "then": { "properties": { "manifest_presence": { "const": "PRESENT" } } }
    },
    {
      "$comment": "A trust conclusion requires a valid manifest.",
      "if": { "properties": { "signer_trust": { "enum": ["TRUSTED", "UNTRUSTED"] } }, "required": ["signer_trust"] },
      "then": { "properties": { "integrity": { "const": "VALID" } } }
    },
    {
      "$comment": "Captured reports are never treated as verification.",
      "if": { "properties": { "mode": { "const": "captured-report" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "integrity": { "const": "NOT_VERIFIED" },
          "signer_trust": { "const": "NOT_CHECKED" }
        }
      }
    },
    {
      "$comment": "ABSENT presence forbids any verification conclusion.",
      "if": { "properties": { "manifest_presence": { "const": "ABSENT" } }, "required": ["manifest_presence"] },
      "then": {
        "properties": {
          "integrity": { "const": "NOT_VERIFIED" },
          "signer_trust": { "const": "NOT_CHECKED" }
        }
      }
    }
  ]
}
